# Port the platform listens on (nginx proxies the public domain to this)
PORT=4500

# Admin login password (the GUI asks only for this password)
ADMIN_PASSWORD=change-me

# Secret used to sign JWT session tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Secret used to validate incoming GitHub webhooks (set the same value in GitHub)
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# --- HTTPS certificates -----------------------------------------------------
# By default the panel uses certbot's nginx/HTTP-01 challenge: Let's Encrypt
# calls back on port 80 of the domain. That only works when port 80 of the
# public name really reaches THIS nginx.
#
# It does not when the domain is proxied by a CDN (Cloudflare orange cloud),
# when a NAT box or a host-level reverse proxy owns ports 80/443, or when the
# provider intercepts them. Set a certbot DNS plugin and the panel proves
# ownership with a DNS TXT record instead — no inbound HTTP needed, and
# wildcards become possible.
#
# Install the matching plugin first, e.g.:
#   apt install python3-certbot-dns-cloudflare
# CERTBOT_DNS_PLUGIN=cloudflare
# CERTBOT_DNS_CREDENTIALS=/root/.secrets/cloudflare.ini
# Seconds to wait for the record to propagate (blank = the plugin's default)
# CERTBOT_DNS_PROPAGATION=30

# --- When something else owns the public ports -------------------------------
# Leave these unset on a normal VPS, where port 80 of your domains reaches
# this nginx directly.
#
# Set them when a host-level reverse proxy, a CDN or a NAT box sits in front:
# NGINX_LISTEN is the address that proxy forwards to (what the panel's server
# blocks then listen on), NGINX_TRUSTED_PROXY is the proxy's address so the
# access log and traffic metrics record the real visitor IP, and
# NGINX_UPSTREAM_TLS=1 says HTTPS is already terminated there — the panel then
# never runs certbot, because there is nothing left here to encrypt.
# NGINX_LISTEN=10.0.0.5:8080
# NGINX_TRUSTED_PROXY=10.0.0.1
# NGINX_UPSTREAM_TLS=1
